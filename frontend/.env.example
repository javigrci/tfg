# sonda — Frontend environment template
# Copiar a .env y ajustar según entorno.

# URL base de la API
# Desarrollo local:    VITE_API_URL=http://localhost:8000/api/v1
# Docker Compose:      VITE_API_URL=/api/v1  (nginx hace el proxy)
VITE_API_URL=http://localhost:8000/api/v1

# ── Suite E2E (Playwright) ───────────────────────────────────────────────────
# Leídas por playwright.config.ts / frontend/e2e/*, NO por Vite — a propósito sin
# prefijo VITE_, para que nunca terminen embebidas en el bundle del cliente.
# E2E_BASE_URL: default http://localhost:5173 si se omite (make dev); en CI apunta
# al servicio frontend del docker-compose.yml de la app.
E2E_BASE_URL=http://localhost:5173
E2E_USERNAME=admin
E2E_PASSWORD=admin
